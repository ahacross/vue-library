{
  "name": "vue-arborist",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/vue-arborist.umd.cjs",
  "module": "./dist/vue-arborist.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-arborist.js",
      "require": "./dist/vue-arborist.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && vue-tsc --noEmit",
    "build:lib": "vite build --mode lib",
    "build:demo": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}